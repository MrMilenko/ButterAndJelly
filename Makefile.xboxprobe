# Boot probe for the original Xbox: same settings as Makefile.xbox, none of
# the client. Paints a colour per stage so a console with no debugger can say
# how far it got.

OXDK_DIR    ?= third_party/OXDK
OXDK_TARGET := xbox
XBE_TITLE   := xboxprobe
OUTPUT_DIR  := bin/probe
XBE_MODE    := RETAIL
OXDK_LIBCXX := 1

include $(OXDK_DIR)/xbox/third-party/SDL2x/oxdk/sdl2x.mk

SRCS = tools/xboxprobe/main.cpp \
       $(OXDK_DIR)/xbox/oxdk/libcxx-shim/libcxx_runtime.cpp \
       $(SDL2X_SRC_LIST) \
       $(SDL2X_DIR)/src/thread/generic/SDL_syscond.c

PROBE_DEFS := -DSTBI_NO_SIMD -DMINIMP3_NO_SIMD -D__PRFCHWINTRIN_H

CFLAGS   += $(SDL2X_DEFINES) $(SDL2X_INCLUDES) $(PROBE_DEFS)
CXXFLAGS += $(SDL2X_DEFINES) $(SDL2X_INCLUDES) $(PROBE_DEFS) -std=gnu++17

OXDK_LIBS = $(SDL2X_LIBS)

include $(OXDK_DIR)/oxdk.mk
