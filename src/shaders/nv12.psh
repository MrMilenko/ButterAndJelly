; NV12 to RGB, on the GPU. Rec.709, limited range.
;
;   y = coefA.x * (luma + coefA.y)
;   r = y + coefA.z * cr
;   g = y + coefA.w * cb + coefB.x * cr
;   b = y + coefB.y * cb
;
; cb and cr have coefB.z, which is -0.5, added to them first.
;
; One instruction per group, deliberately. Latte's register file has read
; port limits, and a group reading several registers alongside two different
; constants needs explicit bank swizzles to get the operands it asked for;
; SDL's own shaders carry VEC_120 modifiers for exactly this. Earlier
; versions packed three MULADDs into a group and produced black luma with
; correct chroma, while a diagnostic reading one uniform and one sample in a
; single group worked. Spending a few more cycles per pixel is nothing
; against getting the operands right.

; $MODE = "UniformRegister"

; $SAMPLER_VARS[0].name = "s_luma"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $SAMPLER_VARS[1].name = "s_chroma"
; $SAMPLER_VARS[1].type = "sampler2D"
; $SAMPLER_VARS[1].location = 1

; $UNIFORM_VARS[0].name = "u_coefA"
; $UNIFORM_VARS[0].type = "vec4"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].offset = 0
; $UNIFORM_VARS[0].block = -1
; $UNIFORM_VARS[1].name = "u_coefB"
; $UNIFORM_VARS[1].type = "vec4"
; $UNIFORM_VARS[1].count = 1
; $UNIFORM_VARS[1].offset = 4
; $UNIFORM_VARS[1].block = -1

; $NUM_SPI_PS_INPUT_CNTL = 1
; $SPI_PS_INPUT_CNTL[0].semantic = 0
; $SPI_PS_INPUT_CNTL[0].default_val = 1

00 TEX: ADDR(48) CNT(2) VALID_PIX
      0  SAMPLE R1, R0.xy0x, t0, s0
      1  SAMPLE R2, R0.xy0x, t1, s1
01 ALU: ADDR(32) CNT(9)
      2  x: ADD R3.x, R1.x, C0.y
      3  x: MUL R3.x, R3.x, C0.x
      4  y: ADD R3.y, R2.x, C1.z
      5  z: ADD R3.z, R2.y, C1.z
      6  x: MULADD R0.x, R3.z, C0.z, R3.x
      7  z: MULADD R0.z, R3.y, C1.y, R3.x
      8  y: MULADD R1.y, R3.y, C0.w, R3.x
      9  y: MULADD R0.y, R3.z, C1.x, R1.y
     10  w: MOV R0.w, C1.w
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
