; Diagnostic shader: two fetches, no conversion. Each plane goes to its own
; channel so it is obvious which fetches are returning data.
;
;   red   = luma
;   green = Cb
;   blue  = Cr
;
; A recognizable picture in red means the luma fetch survives alongside a
; second fetch. A black red channel means the second fetch is breaking the
; first, which is the difference between this and the luma-only shader that
; worked.

; $MODE = "UniformRegister"

; $SAMPLER_VARS[0].name = "s_luma"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $SAMPLER_VARS[1].name = "s_chroma"
; $SAMPLER_VARS[1].type = "sampler2D"
; $SAMPLER_VARS[1].location = 1

; $NUM_SPI_PS_INPUT_CNTL = 1
; $SPI_PS_INPUT_CNTL[0].semantic = 0
; $SPI_PS_INPUT_CNTL[0].default_val = 1

00 TEX: ADDR(48) CNT(2) VALID_PIX
      0  SAMPLE R1, R0.xy0x, t0, s0
      1  SAMPLE R2, R0.xy0x, t1, s1
01 ALU: ADDR(32) CNT(5)
      2  x: MOV R0.x, R1.x
         y: MOV R0.y, R2.x
         z: MOV R0.z, R2.y
         w: MOV R0.w, (0x3F800000, 1.0f).x
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
