; Diagnostic shader: red is a uniform, green is the luma sample.
;
;   red bright, green shows the picture -> uniforms and sampling both work,
;                                          so the fault is the conversion
;   red black, green shows the picture  -> the uniforms are not arriving
;   red bright, green black             -> luma sampling fails in this shader
;
; Expected when healthy: a red-tinted greyscale picture, since C0.x is 1.164
; and clamps to full red.

; $MODE = "UniformRegister"

; $SAMPLER_VARS[0].name = "s_luma"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0

; $UNIFORM_VARS[0].name = "u_coefA"
; $UNIFORM_VARS[0].type = "vec4"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].offset = 0
; $UNIFORM_VARS[0].block = -1
; $UNIFORM_VARS[1].name = "u_coefB"
; $UNIFORM_VARS[1].type = "vec4"
; $UNIFORM_VARS[1].count = 1
; $UNIFORM_VARS[1].offset = 4
; $UNIFORM_VARS[1].block = -1

; $NUM_SPI_PS_INPUT_CNTL = 1
; $SPI_PS_INPUT_CNTL[0].semantic = 0
; $SPI_PS_INPUT_CNTL[0].default_val = 1

00 TEX: ADDR(48) CNT(1) VALID_PIX
      0  SAMPLE R1, R0.xy0x, t0, s0
01 ALU: ADDR(32) CNT(4)
      1  x: MOV R0.x, C0.x
         y: MOV R0.y, R1.x
         z: MOV R0.z, C1.z
         w: MOV R0.w, C1.w
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
