; Diagnostic shader: samples only the luma plane and paints it as grey.
;
; Splits "sampling is broken" from "the conversion maths is broken":
;   a recognisable black and white picture -> sampling works, so the fault is
;                                             in the chroma plane or the
;                                             conversion
;   flat grey, black, or noise             -> the luma fetch itself is not
;                                             returning texture data

; $MODE = "UniformRegister"

; $SAMPLER_VARS[0].name = "s_luma"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0

; $NUM_SPI_PS_INPUT_CNTL = 1
; $SPI_PS_INPUT_CNTL[0].semantic = 0
; $SPI_PS_INPUT_CNTL[0].default_val = 1

00 TEX: ADDR(48) CNT(1) VALID_PIX
      0  SAMPLE R1, R0.xy0x, t0, s0
01 ALU: ADDR(32) CNT(5)
      1  x: MOV R0.x, R1.x
         y: MOV R0.y, R1.x
         z: MOV R0.z, R1.x
         w: MOV R0.w, (0x3F800000, 1.0f).x
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
